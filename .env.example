# Configuración de Conexión de la Aplicación Go
DB_HOST=localhost
DB_PORT=5432
DB_USER=tu_usuario_db
DB_PASSWORD=tu_password_seguro
DB_NAME=albumpedia
APP_PORT=8080

# Secreto para firma HMAC de sesiones de usuario
SESSION_SECRET=reemplazar_por_secreto_aleatorio_seguro
